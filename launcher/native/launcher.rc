#include <winver.h>

1 ICON "../../resources/hoyo_project_studio.ico"
1 24 "launcher.manifest"

1 VERSIONINFO
FILEVERSION 0,4,18,0
PRODUCTVERSION 0,4,18,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "HoYo Project Studio\0"
            VALUE "FileDescription", "HoYo Project Studio launcher\0"
            VALUE "FileVersion", "0.4.18.0\0"
            VALUE "InternalName", "HoYoProjectStudioLauncher\0"
            VALUE "OriginalFilename", "HoYo Project Studio.exe\0"
            VALUE "ProductName", "HoYo Project Studio\0"
            VALUE "ProductVersion", "0.4.18\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
